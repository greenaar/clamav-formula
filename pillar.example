---
clamav:
  clamd:
    config:
      LocalSocket: /run/clamav/clamd.ctl
      LocalSocketGroup: mtagroup
      LocalSocketMode: 660
      User: clamav
      MaxScanSize: 100M
      MaxFileSize: 25M
      MaxThreads: 12
  freshclam:
    config:
      DatabaseOwner: clamav
      DatabaseMirror:
        - database.clamav.net
      Checks: 12
      NotifyClamd: /etc/clamav/clamd.conf
